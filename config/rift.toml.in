[settings]
animate = false
animation_duration = 0.0
default_disable = false
hot_reload = true
mouse_follows_focus = false
mouse_hides_on_focus = false
focus_follows_mouse = false
auto_focus_blacklist = ["io.github.macricing.keyboard-desk", "com.apple.Spotlight", "com.apple.finder"]
run_on_start = ["rift-events.sh", "workspace-request remember"]

[settings.drag_drop]
enabled = false

[settings.gestures]
enabled = false

[settings.layout]
mode = "traditional"

[settings.layout.gaps.inner]
horizontal = 6.0
vertical = 6.0

[settings.layout.gaps.outer]
top = 5.0
bottom = 32.0
left = 5.0
right = 5.0

[settings.ui.menu_bar]
enabled = false

[settings.ui.mission_control]
enabled = false
fade_enabled = false

[virtual_workspaces]
mode = "global"
default_workspace_count = 10
workspace_names = ["Code", "Web", "Terminal", "Comms", "Projects", "Docs", "Review", "Media", "Tools", "Spare"]

[keys]
"Alt + 1" = { exec = ["@BIN@/workspace-request", "0"] }
"Alt + 2" = { exec = ["@BIN@/workspace-request", "1"] }
"Alt + 3" = { exec = ["@BIN@/workspace-request", "2"] }
"Alt + 4" = { exec = ["@BIN@/workspace-request", "3"] }
"Alt + 5" = { exec = ["@BIN@/workspace-request", "4"] }
"Alt + 6" = { exec = ["@BIN@/workspace-request", "5"] }
"Alt + 7" = { exec = ["@BIN@/workspace-request", "6"] }
"Alt + 8" = { exec = ["@BIN@/workspace-request", "7"] }
"Alt + 9" = { exec = ["@BIN@/workspace-request", "8"] }
"Alt + 0" = { exec = ["@BIN@/workspace-request", "9"] }
"Alt + Shift + 1" = { move_window_to_workspace = 0 }
"Alt + Shift + 2" = { move_window_to_workspace = 1 }
"Alt + Shift + 3" = { move_window_to_workspace = 2 }
"Alt + Shift + 4" = { move_window_to_workspace = 3 }
"Alt + Shift + 5" = { move_window_to_workspace = 4 }
"Alt + Shift + 6" = { move_window_to_workspace = 5 }
"Alt + Shift + 7" = { move_window_to_workspace = 6 }
"Alt + Shift + 8" = { move_window_to_workspace = 7 }
"Alt + Shift + 9" = { move_window_to_workspace = 8 }
"Alt + Shift + 0" = { move_window_to_workspace = 9 }
"Alt + Tab" = { exec = ["@BIN@/workspace-request", "last"] }
"Ctrl + Left" = { exec = ["@BIN@/workspace-request", "left"] }
"Ctrl + Right" = { exec = ["@BIN@/workspace-request", "right"] }
"Alt + Enter" = { exec = ["@BIN@/terminal.sh"] }
"Alt + H" = { move_focus = "left" }
"Alt + J" = { move_focus = "down" }
"Alt + K" = { move_focus = "up" }
"Alt + L" = { move_focus = "right" }
"Alt + Left" = { move_focus = "left" }
"Alt + Down" = { move_focus = "down" }
"Alt + Up" = { move_focus = "up" }
"Alt + Right" = { move_focus = "right" }
"Alt + N" = "next_window"
"Alt + P" = "prev_window"
"Alt + Shift + H" = { move_node = "left" }
"Alt + Shift + J" = { move_node = "down" }
"Alt + Shift + K" = { move_node = "up" }
"Alt + Shift + L" = { move_node = "right" }
"Alt + Shift + Left" = { join_window = "left" }
"Alt + Shift + Down" = { join_window = "down" }
"Alt + Shift + Up" = { join_window = "up" }
"Alt + Shift + Right" = { join_window = "right" }
"Alt + E" = "toggle_orientation"
"Alt + W" = "toggle_stack"
"Alt + S" = { exec = ["@BIN@/swap-window.sh"] }
"Alt + Ctrl + E" = "unjoin_windows"
"Alt + Shift + Space" = "toggle_window_floating"
"Alt + F" = "toggle_fullscreen"
"Alt + Shift + F" = "toggle_fullscreen_within_gaps"
"Alt + Equal" = { resize_window_grow = "smart" }
"Alt + Minus" = { resize_window_shrink = "smart" }
"Alt + R" = { binding_mode = "resize" }
"Alt + Shift + Q" = "close_window"
"Alt + Shift + C" = "reload_config"
"Alt + Z" = "toggle_space_activated"
"Alt + Ctrl + 1" = { set_workspace_layout = { mode = "traditional" } }
"Alt + Ctrl + 2" = { set_workspace_layout = { mode = "bsp" } }
"Alt + Ctrl + 3" = { set_workspace_layout = { mode = "master_stack" } }
"Alt + Ctrl + S" = { exec = ["@RIFT_CLI@", "execute", "save-layout", "--master"] }
"Alt + Ctrl + Shift + R" = { exec = ["@BIN@/restart-rift.sh"] }
"Alt + Ctrl + Shift + B" = { exec = ["@BIN@/restart-bar.sh"] }

[binding_modes.resize]
"H" = { resize_window_shrink = "horizontal" }
"L" = { resize_window_grow = "horizontal" }
"K" = { resize_window_shrink = "vertical" }
"J" = { resize_window_grow = "vertical" }
"B" = "balance"
"Escape" = { binding_mode = "default" }
"Enter" = { binding_mode = "default" }
